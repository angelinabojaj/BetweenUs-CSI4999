<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.betweenus.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_productivity"
        android:name="com.example.betweenus.fragments.ProductivityFragment"
        android:label="Productivity"
        tools:layout="@layout/fragment_productivity" />

    <!-- Placeholder fragments for other bottom nav items -->
    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.example.betweenus.ui.dashboard.DashboardFragment"
        android:label="Chat" />

    <fragment
        android:id="@+id/navigation_memories"
        android:name="com.example.betweenus.ui.notifications.NotificationsFragment"
        android:label="Memories" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.betweenus.ui.notifications.NotificationsFragment"
        android:label="Profile" />

</navigation>
