<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#BFEFFF"
    android:orientation="horizontal"
    tools:context=".activities.PomodoroActivity">

    <LinearLayout
        android:id="@+id/widgetContainer"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginEnd="20dp"
        android:weightSum="2">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardDashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
          >

            <include layout="@layout/widget_dashboard"/>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTodo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp">

            <include layout="@layout/widget_todo"/>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">
    <ImageView
        android:id="@+id/avatarCenter"
        android:layout_width="100dp"
        android:layout_height="180dp"
        android:src="@drawable/bunny_happy"
        android:translationY="20dp"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:elevation="2dp" />

    <View

        android:layout_width="100dp"
        android:layout_height="20dp"
        android:background="@drawable/avatar_shadow"
        android:layout_marginTop="4dp" />
  </LinearLayout>

    <!-- TIMER AREA -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Circular Progress -->
        <ProgressBar
            android:id="@+id/circleTimer"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerInParent="true"
            android:max="100"
            android:progress="100"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circular_progress"/>

        <!-- Time Text -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="25:00"
            android:textSize="40sp" />

        <!-- Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnStart"
                android:text="Start" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnCustomize"
                android:text="Customize" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnSound"
                android:text="Sound" />
        </LinearLayout>

    </RelativeLayout>


</LinearLayout>