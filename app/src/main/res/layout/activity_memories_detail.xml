<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MemoriesDetailActivity"
    android:background="#FAFAFA">

    <!-- Memory Image -->
    <ImageView
        android:id="@+id/memory_image"
        android:layout_width="0dp"
        android:layout_margin="20dp"
        android:layout_height="240dp"
        android:scaleType="fitCenter"
        android:src="@drawable/memorybtn_filled"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Settings Button Floating -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        android:src="@drawable/settings_btn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/black" />

    <!-- Memory Title -->
    <TextView
        android:id="@+id/memory_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Memory Title Example"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#222"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/memory_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Memory Body -->
    <TextView
        android:id="@+id/memory_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Memory body example text goes here..."
        android:textSize="16sp"
        android:textColor="#444"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/memory_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Likes -->
    <TextView
        android:id="@+id/memory_likes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 ❤"
        android:textSize="14sp"
        android:textColor="#777"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/memory_body"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Comments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_comments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/memory_likes"
        app:layout_constraintBottom_toTopOf="@id/comment_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Comment Bar -->
    <LinearLayout
        android:id="@+id/comment_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="#FFFFFF"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_comment"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Add a comment..."
            android:paddingStart="12dp"
            android:background="@android:drawable/edit_text"
            android:textSize="14sp"/>

        <ImageButton
            android:id="@+id/btn_send_comment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@android:color/transparent"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>