<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/taskCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:radius="12dp"
    android:elevation="4dp">

    <RelativeLayout
        android:id="@+id/taskContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#BAD7DB">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/assignerProfileImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:src="@drawable/profilebtn_filled"
            app:tint="@color/white" />

        <!-- Checkbox to mark as complete -->
        <CheckBox
            android:id="@+id/task_complete_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/assignerProfileImage"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp" />

        <!-- Task Title -->
        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/task_complete_checkbox"
            android:layout_toStartOf="@id/deleteTaskButton"
            android:layout_marginStart="8dp"
            android:text="Task1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Due Date -->
        <TextView
            android:id="@+id/taskTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/taskTitle"
            android:layout_toEndOf="@id/task_complete_checkbox"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:text="time: 30min"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/deleteTaskButton"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@android:color/transparent"
            android:src="@drawable/delete_taskbtn"
            android:contentDescription="Delete Task"
            app:tint="@color/white" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
